<!--
  INFO, and not the DEBUG Logback falls back to when it finds no configuration. At DEBUG the
  connection pool and the driver describe their connections, and this process's connection string
  carries the database password.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
